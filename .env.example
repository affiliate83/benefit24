# ── WordPress 연결 정보 ──────────────────────────────────────────
# WordPress 관리자 계정
WP_URL=https://benefit24.aqmme.com
WP_USER=워드프레스_관리자_아이디
# WordPress 관리자 > 사용자 > 프로필 > 애플리케이션 비밀번호 에서 생성
WP_APP_PASS=xxxx xxxx xxxx xxxx xxxx xxxx

# ── 공공데이터포털 API 키 ─────────────────────────────────────────
# https://www.data.go.kr 회원가입 후 "중앙부처복지서비스 API" 신청
DATA_GO_KR_API_KEY=여기에_인증키_입력

# ── Claude API 키 (선택사항, 콘텐츠 AI 강화용) ────────────────────
# https://console.anthropic.com 에서 발급
# 없어도 기본 콘텐츠로 포스팅 가능
ANTHROPIC_API_KEY=

# ── 스윙투앱 푸시 알림 (send_push.py 전용) ───────────────────────
# GitHub Actions Secrets에 설정되어 있음 — 로컬 테스트 시에만 사용
SWING2APP_APP_ID=
SWING2APP_API_KEY=